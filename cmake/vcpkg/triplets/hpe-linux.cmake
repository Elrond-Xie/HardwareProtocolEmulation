if(DEFINED ENV{HPE_VCPKG_ARCH})
    set(VCPKG_TARGET_ARCHITECTURE "$ENV{HPE_VCPKG_ARCH}")
else()
    set(VCPKG_TARGET_ARCHITECTURE x64)
endif()
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE dynamic)
set(VCPKG_BUILD_TYPE release)
set(X_VCPKG_FORCE_VCPKG_X_LIBRARIES ON)
set(X_VCPKG_FORCE_VCPKG_WAYLAND_LIBRARIES ON)
set(VCPKG_ENV_PASSTHROUGH PATH ACLOCAL_PATH HPE_ZIG HPE_CC HPE_CXX HPE_CCACHE HPE_GPERF HPE_PYTHON3 CCACHE_DIR CCACHE_BASEDIR CCACHE_COMPILERCHECK)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../../toolchains/zig.cmake")
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
