# SD v2 standard-capacity card: byte addressing and one 512-byte block.
sd-card sdcard 128 0xFF
card-cmd 0 0 0
card-cmd 0 8 0x1AA
card-cmd 0 55 0
card-cmd 0 41 0x40FF8000
card-cmd 0 55 0
card-cmd 0 41 0x40FF8000
card-cmd 0 2 0
card-cmd 0 3 0
card-cmd 0 9 0x12340000
card-cmd 0 10 0x12340000
card-register 0 CID
card-register 0 CSD
card-cmd 0 7 0x12340000
card-cmd 0 55 0x12340000
card-cmd 0 6 2
card-cmd 0 16 512
card-cmd 0 24 0x400
card-write 0 2 0x5A
card-cmd 0 17 0x400
card-read 0 2
card-cmd 0 18 0x400
card-read 0 2
card-read 0 3
card-cmd 0 12 0

# eMMC initialization uses CMD1 and host-assigned RCA.
emmc-card emmc 128 0x00
card-cmd 1 0 0
card-cmd 1 1 0x40FF8000
card-cmd 1 1 0x40FF8000
card-cmd 1 2 0
card-cmd 1 3 0x00010000
card-cmd 1 9 0x00010000
card-register 1 CID
card-register 1 CSD
card-cmd 1 7 0x00010000
card-cmd 1 6 0x03B70200
card-cmd 1 6 0x03B90100
card-register 1 EXT_CSD
card-cmd 1 8 0
card-read 1 0
card-register 1 EXT_CSD
card-cmd 1 24 3
card-write 1 3 0xA5
card-cmd 1 17 3
card-read 1 3
card-cmd 1 23 2
card-cmd 1 25 4
card-write 1 4 0x3C
card-write 1 5 0xC3
card-cmd 1 23 2
card-cmd 1 18 4
card-read 1 4
card-read 1 5

# SDHC profile uses a sparse 2 GiB virtual medium and block addressing.
sd-card sdhc 4194304 0xFF
card-cmd 2 0 0
card-cmd 2 8 0x1AA
card-cmd 2 55 0
card-cmd 2 41 0x40FF8000
card-cmd 2 55 0
card-cmd 2 41 0x40FF8000
card-cmd 2 2 0
card-cmd 2 3 0
card-cmd 2 7 0x12340000
card-cmd 2 24 2
card-write 2 2 0x5A
card-cmd 2 17 2
card-read 2 2
card-register 2 CSD
