# Software-only SPI NOR example.
# Generic JEDEC manufacturer/type; capacity byte reflects configured size.
spi-device flash 0 65536 0xFF

# Read the three-byte JEDEC ID (EF 40 13 for this 64 KiB model).
spi-transfer 0 0 0x9F 0x00 0x00 0x00

# Enable writes, program four bytes at address 0x000010, then read them back.
spi-transfer 0 0 0x06
spi-transfer 0 0 0x02 0x00 0x00 0x10 0xDE 0xAD 0xBE 0xEF
spi-transfer 0 0 0x03 0x00 0x00 0x10 0x00 0x00 0x00 0x00

# Set BP2:BP0 to protect the entire array, then observe that programming is ignored.
spi-transfer 0 0 0x06
spi-transfer 0 0 0x01 0x1C
spi-transfer 0 0 0x05 0x00
spi-transfer 0 0 0x06
spi-transfer 0 0 0x02 0x00 0x00 0x10 0x00
spi-transfer 0 0 0x03 0x00 0x00 0x10 0x00 0x00 0x00 0x00
